{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formilyjs/antd.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "formily-tpl build",
    "build:docs": "dumi build",
    "lint": "eslint .",
    "release": "lerna publish from-package --yes",
    "start": "dumi dev",
    "test": "jest --coverage",
    "test:prod": "jest --coverage --silent",
    "preversion": "pnpm install && npm run build && npm run lint",
    "version:alpha": "lerna version prerelease --preid alpha",
    "version:beta": "lerna version prerelease --preid beta",
    "version:major": "lerna version major",
    "version:minor": "lerna version minor",
    "version:patch": "lerna version patch",
    "version:preminor": "lerna version preminor --preid beta",
    "version:rc": "lerna version prerelease --preid rc"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js}": [
      "eslint --ext .ts,.tsx,.js",
      "prettier --write"
    ],
    "docs/**/*.{ts,tsx,js}": [
      "eslint --ext .ts,.tsx,.js",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "ghooks": {
      "pre-commit": "lint-staged --concurrent false",
      "commit-msg": "commitlint --edit"
    }
  },
  "resolutions": {
    "rollup-plugin-typescript2": "^0.34.1"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.2",
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@commitlint/prompt-cli": "^17.3.0",
    "@formily/core": "^2.3.7",
    "@formily/json-schema": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@formily/reactive": "^2.3.7",
    "@formily/shared": "^2.3.7",
    "@formily/template": "^1.0.0-alpha.21",
    "@testing-library/jest-dom": "^5.0.0",
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^24.0.18",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "antd": "^6.5.0",
    "classnames": "^2.5.1",
    "cross-env": "^10.0.1",
    "dayjs": "1.11.11",
    "dumi": "^2.4.45",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.13.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.14.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "fs-extra": "^10.1.0",
    "ghooks": "^2.0.4",
    "glob": "^8.0.3",
    "jest": "^26.0.0",
    "jest-codemods": "^0.19.1",
    "jest-dom": "^3.1.2",
    "jest-localstorage-mock": "^2.3.0",
    "jest-styled-components": "6.3.3",
    "jest-watch-lerna-packages": "^1.1.0",
    "lerna": "^9.0.7",
    "lint-staged": "^13.0.4",
    "mfetch": "^0.2.27",
    "moment": "^2.29.4",
    "prettier": "^3.9.5",
    "pretty-format": "^29.3.1",
    "pretty-quick": "^4.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "rimraf": "^6.1.3",
    "staged-git-files": "^1.3.0",
    "ts-jest": "^26.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.2"
  }
}
